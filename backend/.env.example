# Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL + PostGIS)
# When DATABASE_URL is reachable, the backend connects to PostgreSQL.
# Otherwise, it initializes the local seeded in-memory store for instant zero-dependency testing.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/livestock_surveillance

# Authentication Secrets
JWT_ACCESS_SECRET=livestock_dev_access_secret_super_secure_key_2026!
JWT_REFRESH_SECRET=livestock_dev_refresh_secret_super_secure_key_2026!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Microservices
ML_SERVICE_URL=http://localhost:8000

# CORS
CLIENT_ORIGIN=http://localhost:5173
